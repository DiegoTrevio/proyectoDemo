# =============================================================================
# AgentOS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys:  cp .env.example .env
#
# Cost tiers (see COSTS.md for details):
#   Dev:        ~$60/month  (Required keys only)
#   Production: ~$100/month (+ Recommended keys)
#   Enterprise: ~$660/month (+ all Optional keys)
# =============================================================================


# =============================================================================
# REQUIRED — AgentOS will NOT work without these
# =============================================================================

# LLM — Orchestrator (Claude Opus) + Workhorse (Claude Sonnet)  ~$30/month
ANTHROPIC_API_KEY=sk-ant-xxxxx

# LLM — Workhorse-Gemini + Cheap tier (Gemini Flash)  ~$5/month (generous free tier)
GOOGLE_API_KEY=xxxxx

# Search — Used for all research complexity levels  ~$20/month
TAVILY_API_KEY=tvly-xxxxx

# Code execution — Ephemeral sandboxes for Coder Agent  ~$10/month
E2B_API_KEY=xxxxx

# LiteLLM — Internal router key (self-hosted, no external cost)
LITELLM_MASTER_KEY=sk-litellm-xxxxx


# =============================================================================
# SELF-HOSTED INFRASTRUCTURE — No external API cost
# =============================================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentOS
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentOS

# Cache & PubSub
REDIS_URL=redis://redis:6379

# Knowledge Graph
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentOS-neo4j-password

# Auth (self-hosted SuperTokens)
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567

# Agent Orchestration (self-hosted DeerFlow 2.0)
DEERFLOW_GATEWAY_URL=http://deerflow-gateway:8001
DEERFLOW_LANGGRAPH_URL=http://deerflow-langgraph:2024
DEERFLOW_ENABLED=true

# Observability (self-hosted Langfuse)
LANGFUSE_PUBLIC_KEY=pk-xxxxx
LANGFUSE_SECRET_KEY=sk-xxxxx
LANGFUSE_HOST=http://langfuse:3001
LANGFUSE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/langfuse


# =============================================================================
# RECOMMENDED — Cost optimization + specialized capabilities
# =============================================================================

# Search — Better results for medium+ complexity queries  ~$50/month
EXA_API_KEY=xxxxx

# Cost optimization — Qwen for simple/medium tasks, Kimi for browser  ~$10/month total
# Without these, the model router falls back to Gemini/Sonnet (still works, just costs more)
QWEN_API_KEY=xxxxx                # Alibaba DashScope — simple code, docs, research
KIMI_API_KEY=xxxxx                # Moonshot — browser agent tool-calling specialist

# Memory — Intelligent user memory (primary L1)  ~$30/month  (get key at console.supermemory.ai)
SUPERMEMORY_API_KEY=xxxxx

# Memory — Fallback L1 memory (used when Supermemory not configured)  Free tier available
MEM0_API_KEY=xxxxx


# =============================================================================
# OPTIONAL — Enable specific features, comment out if not needed
# =============================================================================

# LLM fallbacks — Extra providers for redundancy
# OPENAI_API_KEY=sk-xxxxx           # Fallback LLM
# PERPLEXITY_API_KEY=pplx-xxxxx     # Factual search specialist  ~$20/month

# Deep web extraction — Only for complex research queries  ~$100/month
# FIRECRAWL_API_KEY=xxxxx

# Anti-bot browser — Stealth sessions, CAPTCHA solving  ~$100/month  (Playwright fallback is free)
# STEEL_API_KEY=xxxxx

# SaaS integrations — Gmail, Slack, Notion, GitHub, etc. (150+ apps)  ~$200/month
# COMPOSIO_API_KEY=xxxxx

# Payments — Stripe subscription billing  (2.9% + $0.30/txn)
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Hermes Agent v0.6.0 — Nous Research (REQUIRED SERVICE)
# 40+ tools, multi-instance profiles, MCP server, fallback providers
HERMES_ENABLED=true
HERMES_API_URL=http://hermes:3000           # HTTP API mode (required)
HERMES_CLI_PATH=hermes                       # CLI fallback path
HERMES_MODEL=anthropic/claude-sonnet-4
HERMES_TIMEOUT=300
HERMES_PROFILE=agentos                       # v0.6.0 — isolated profile name
HERMES_MCP_ENABLED=true                      # v0.6.0 — expose tools via MCP protocol
HERMES_FALLBACK_PROVIDERS=                   # v0.6.0 — ordered failover: "anthropic,openrouter,openai"
HERMES_SKILLS_DIR=/root/.hermes/skills       # v0.6.0 — external skills directory
# Paperclip adapter — enables task management bridge (github.com/NousResearch/hermes-paperclip-adapter)
HERMES_PAPERCLIP_ENABLED=false


# =============================================================================
# SECURITY — Review before production
# =============================================================================
MANIFEST_SIGNING_KEY=              # Auto-generated if empty (64 hex chars Ed25519 seed)
API_KEY_SALT=                      # Random if empty — SET THIS for API key persistence across restarts!
CORS_ORIGINS=                      # Defaults to FRONTEND_URL — set explicit origins for production

# URLs — Override for production deployments
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
OLLAMA_API_BASE=http://localhost:11434
LITELLM_BASE_URL=http://litellm:4000     # Docker default; use http://localhost:4000 for local dev


# =============================================================================
# FRONTEND (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_URL=http://localhost:3000
