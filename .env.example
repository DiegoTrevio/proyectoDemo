# =============================================================================
# AgentOS - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# =============================================================================

# --- LLM API Keys ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
GOOGLE_API_KEY=xxxxx
KIMI_API_KEY=xxxxx
QWEN_API_KEY=xxxxx

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-litellm-xxxxx

# --- Search & Web ---
TAVILY_API_KEY=tvly-xxxxx
EXA_API_KEY=xxxxx
FIRECRAWL_API_KEY=xxxxx
PERPLEXITY_API_KEY=pplx-xxxxx

# --- Execution & Sandbox ---
E2B_API_KEY=xxxxx
COMPOSIO_API_KEY=xxxxx
STEEL_API_KEY=xxxxx

# --- Memory ---
MEM0_API_KEY=xxxxx

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentOS
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agentOS

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentOS-neo4j-password

# --- Langfuse (Observability) ---
LANGFUSE_PUBLIC_KEY=pk-xxxxx
LANGFUSE_SECRET_KEY=sk-xxxxx
LANGFUSE_HOST=http://langfuse:3001
LANGFUSE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/langfuse

# --- Auth (SuperTokens) ---
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567

# --- Media & Voice ---
ELEVENLABS_API_KEY=xxxxx
DEEPGRAM_API_KEY=xxxxx

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_xxxxx
