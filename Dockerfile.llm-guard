FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir llm-guard fastapi uvicorn

COPY backend/security/llm_guard_server.py .

EXPOSE 8080

CMD ["uvicorn", "llm_guard_server:app", "--host", "0.0.0.0", "--port", "8080"]
