FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir llm-guard[gpu]==0.3.15 fastapi==0.115.6 uvicorn[standard]==0.34.0 \
    presidio-analyzer==2.2.355 presidio-anonymizer==2.2.355

# Copy the security module as a package so imports work
COPY backend/security/__init__.py security/
COPY backend/security/llm_guard_config.py security/
COPY backend/security/llm_guard_server.py .

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080

CMD ["uvicorn", "llm_guard_server:app", "--host", "0.0.0.0", "--port", "8080"]
